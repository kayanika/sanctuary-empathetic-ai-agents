OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx

# Path to DAIC-WOZ data (set after access is approved)
DAIC_WOZ_PATH=

# ChromaDB persistence directory
CHROMA_DB_PATH=./data/chroma_db


MODEL_PROVIDER=ollama

# OpenRouter (used when MODEL_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Free tier: ~20 requests/min, 200 requests/day. One pipeline turn = 5 requests.
